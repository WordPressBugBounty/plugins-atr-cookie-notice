msgid "Quickly apply a preset (applies on Save)."
msgstr "החלה מהירה של פריסט (מוחלת בעת שמירה)."

#: admin/class-atr-cookie-notice-admin-settings.php:692
msgid "Light"
msgstr "בהיר"

#: admin/class-atr-cookie-notice-admin-settings.php:693
msgid "Dark"
msgstr "כהה"

#: admin/class-atr-cookie-notice-admin-settings.php:694
msgid "Minimal"
msgstr "מינימלי"

#: admin/class-atr-cookie-notice-admin-settings.php:695
msgid "High Contrast"
msgstr "ניגודיות גבוהה"

#: admin/class-atr-cookie-notice-admin-settings.php:701
msgid "Force override theme styles"
msgstr "כפה עקיפה של סגנונות עיצוב מתבנית האתר"

#: admin/class-atr-cookie-notice-admin-settings.php:702
msgid "When enabled, the banner uses high-specificity rules and !important to win against aggressive theme/optimizer CSS."
msgstr "כאשר הבאנר מופעל, הוא משתמש בכללי ספציפיות גבוהה וב-!important כדי להתגבר על CSS אגרסיבי של ערכות נושא/אופטימיזציה."

#: admin/class-atr-cookie-notice-admin-settings.php:708
msgid "Enable Debug Mode"
msgstr "הפעל מצב דיבאג"

#: admin/class-atr-cookie-notice-admin-settings.php:709
msgid "Show debug information in browser console (for development only)."
msgstr "הצג מידע דיבאג בקונסול הדפדפן (לפיתוח בלבד)."

#: admin/class-atr-cookie-notice-admin-settings.php:715
msgid "Cookie Expiry (days)"
msgstr "תוקף עוגיות (ימים)"

#: admin/class-atr-cookie-notice-admin-settings.php:716
msgid "How long to remember user consent (in days)."
msgstr "כמה זמן לזכור את הסכמת המשתמש (בימים)."

#: admin/class-atr-cookie-notice-admin-settings.php:727
msgid "Content"
msgstr "תוכן"

#: admin/class-atr-cookie-notice-admin-settings.php:728
msgid "Customize the text and primary actions shown in the banner. Leave empty to use the default (translated) content. Allowed tags: a, button, strong, em, span, br, p. Allowed attributes: href, rel, target, role, class, id, type. Tokens: {site_name}, {privacy_url}, {privacy_link}. Buttons: [ok_button] (simple), [privacy_link] (simple), [accept_all_button], [reject_button], [preferences_button] (full)."
msgstr "התאימו אישית את הטקסט והפעולות העיקריות המוצגות בבאנר. השאירו ריק כדי להשתמש בתוכן ברירת המחדל (מתורגם). תגיות מותרות: a, button, strong, em, span, br, p. מאפיינים מותרים: href, rel, target, role, class, id, type. טוקנים: {site_name}, {privacy_url}, {privacy_link}. כפתורים: [ok_button] (simple), [privacy_link] (simple), [accept_all_button], [reject_button], [preferences_button] (full)."

#: admin/class-atr-cookie-notice-admin-settings.php:736
msgid "Simple Mode — Text HTML"
msgstr "מצב פשוט - HTML טקסטואלי"

#: admin/class-atr-cookie-notice-admin-settings.php:737
#: admin/class-atr-cookie-notice-admin-settings.php:753
msgid "Banner description area (inside .scb-text). Tokens supported: {site_name}."
msgstr "אזור תוכן בבאנר (בתוך טקסט .scb-text). אסימונים נתמכים: {site_name}."

#: admin/class-atr-cookie-notice-admin-settings.php:744
msgid "Simple Mode — Actions HTML"
msgstr "מצב פשוט - פעולות HTML"

#: admin/class-atr-cookie-notice-admin-settings.php:745
msgid "Primary actions area (inside .scb-actions). Tokens supported: {privacy_url}. Buttons: [ok_button], [privacy_link]. If required IDs are missing, defaults will be appended."
msgstr "אזור הפעולות העיקריות (בתוך .scb-actions). טוקנים נתמכים: {privacy_url}. כפתורים: [ok_button], [privacy_link]. אם חסרים מזהים נדרשים (ID), יתווספו ערכי ברירת מחדל."

#: admin/class-atr-cookie-notice-admin-settings.php:752
msgid "Full Mode — Text HTML"
msgstr "מצב מלא - טקסט HTML"

#: admin/class-atr-cookie-notice-admin-settings.php:760
msgid "Full Mode — Actions HTML"
msgstr "מצב מלא - HTML פעולות"

#: admin/class-atr-cookie-notice-admin-settings.php:761
msgid "Primary actions area (inside .scb-actions). Tokens supported: {privacy_url}. Buttons: [accept_all_button], [reject_button], [preferences_button]. If required IDs are missing, defaults will be appended."
msgstr "אזור הפעולות העיקריות (בתוך קובץ .scb-actions). טוקנים נתמכים: {privacy_url}. כפתורים: [accept_all_button], [reject_button], [preferences_button]. אם חסרים מזהים נדרשים (ID), יתווספו ערכי ברירת מחדל."

#: admin/class-atr-cookie-notice-admin-settings.php:768
msgid "Full Mode — Footer HTML"
msgstr "מצב מלא - HTML של הפוטר"

#: admin/class-atr-cookie-notice-admin-settings.php:769
msgid "Footer area (inside .scb-footer). Tokens supported: {privacy_url}, {privacy_link}. {privacy_link} renders a full anchor with the Privacy Policy page title. Leave empty to use the default Privacy Policy link."
msgstr "אזור הפוטר (בתוך .scb-footer). אסימונים נתמכים: {privacy_url}, {privacy_link}. ‏{privacy_link} מציג קישור מלא עם כותרת עמוד מדיניות הפרטיות. יש להשאיר ריק כדי להשתמש בקישור ברירת המחדל למדיניות הפרטיות."

#: admin/class-atr-cookie-notice-admin-settings.php:778
#: admin/class-atr-cookie-notice-admin-settings.php:1300
msgid "Tools"
msgstr "כלים"

#: admin/class-atr-cookie-notice-admin-settings.php:779
